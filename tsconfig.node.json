// TSConfig for tooling modules that run in Node.js.
{
  "extends": "@tsconfig/node24/tsconfig.json",
  "include": [
    "config/**/*.ts",
    "vite.config.*",
    "vitest.config.*",
    "playwright*.config.*",
    "playwright*.test.*",
    "pwa-assets.config.*",
    "eslint.config.*",
    "tests/**/*.ts",
    "**/*.d.mts",
    "src/**/*.visual.spec.ts",
    "src/**/*.behavior.spec.ts",
    "src/**/*.browser-integration.spec.ts",
    "src/**/*.performance.spec.ts",
    ".storybook/**/*.behavior.spec.ts",
    // The canonical channel/cache/path pure contract (see its own doc
    // comment): deliberately owned by `src/` alongside its other
    // `appUpdate` runtime consumers, but has zero imports of its own, so
    // this single explicit entry is enough for `config/plugins/pwa.ts` to
    // import it without pulling the application's `tsconfig.app.json`
    // project into this one.
    "src/shared/service/appUpdate/channelContract.ts",
    // playwright.config.ts resolves per-project testIgnore from this
    // verifier-owned module; explicit entry needed for the same reason as
    // channelContract.ts above.
    "scripts/lib/e2eProjectApplicability.ts",
    // MDIconButton.behavior.spec.ts's own colocated Playwright test helper;
    // explicit entry needed for the same reason as channelContract.ts above.
    "src/shared/ui/Button/MDIconButton.testUtils.ts"
  ],
  "compilerOptions": {
    "composite": true,
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo",
    "module": "preserve",
    "moduleResolution": "bundler",
    "types": ["node"],
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "allowSyntheticDefaultImports": true
  }
}
