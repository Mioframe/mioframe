// TSConfig for tooling modules that run in Node.js.
{
  "extends": "@tsconfig/node24/tsconfig.json",
  "include": [
    "config/**/*.ts",
    "vite.config.*",
    "vitest.config.*",
    "playwright*.config.*",
    "playwright*.test.*",
    "pwa-assets.config.*",
    "eslint.config.*",
    "tests/**/*.ts",
    "**/*.d.mts",
    "src/**/*.browser.spec.ts",
    "src/**/*.visual.spec.ts",
    // The canonical channel/cache/path pure contract (see its own doc
    // comment): deliberately owned by `src/` alongside its other
    // `appUpdate` runtime consumers, but has zero imports of its own, so
    // this single explicit entry is enough for `config/plugins/pwa.ts` to
    // import it without pulling the application's `tsconfig.app.json`
    // project into this one.
    "src/shared/service/appUpdate/channelContract.ts"
  ],
  "compilerOptions": {
    "composite": true,
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo",
    "module": "preserve",
    "moduleResolution": "bundler",
    "types": ["node"],
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "allowSyntheticDefaultImports": true
  }
}
