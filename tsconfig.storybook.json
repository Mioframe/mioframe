{
  "extends": "./tsconfig.src.json",
  "include": [
    "env.d.ts",
    ".storybook/**/*.ts",
    "config/**/*.ts",
    "src/**/*",
    "src/**/*.vue",
    "src/**/*.stories.ts",
    "src/**/*.stories.tsx",
    "src/**/*.stories.js",
    "src/**/*.stories.jsx",
    "src/**/*.stories.mjs",
    "src/**/*.stories.vue"
  ],
  "exclude": [
    "src/**/*.visual.spec.ts",
    "src/**/*.behavior.spec.ts",
    "src/**/*.browser-integration.spec.ts",
    "src/**/*.performance.spec.ts",
    ".storybook/**/*.behavior.spec.ts"
  ],
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.storybook.tsbuildinfo",
    "types": ["node", "@types/wicg-file-system-access"],
    "lib": ["ESNext", "DOM", "DOM.Iterable", "WebWorker"],
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true
  }
}
